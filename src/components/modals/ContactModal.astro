---
const waPhone = '56961937877';
const waMessage =
  'Hola, te contacto desde tu portafolio web. Me gustaría conversar contigo.';
const whatsappHref = `https://wa.me/${waPhone}?text=${encodeURIComponent(waMessage)}`;
---

<div class="modal fade" id="contactModal" tabindex="-1" role="dialog" aria-labelledby="contactModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header modal-header--contact">
        <h5 class="modal-title" id="contactModalLabel">Contacto</h5>
        <button type="button" class="close modal-close" data-dismiss="modal" aria-label="Cerrar">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body modal-body--contact">
        <div class="d-none d-md-block">
          <div class="row contact-info-cards contact-modal-grid g-3">
            <div class="col-md-4 col-12">
              <a href={whatsappHref} class="contact-card contact-card--link h-100" target="_blank" rel="noopener noreferrer">
                <div class="contact-icon"><i class="fa fa-whatsapp" aria-hidden="true"></i></div>
                <div class="contact-text">
                  <h6 class="mb-1">WhatsApp</h6>
                  <p class="mb-0 contact-card-line">+56 9 6193 7877</p>
                </div>
              </a>
            </div>
            <div class="col-md-4 col-12">
              <div class="contact-card contact-card--soon h-100">
                <div class="contact-icon contact-icon--muted"><i class="fa fa-envelope" aria-hidden="true"></i></div>
                <div class="contact-text">
                  <h6 class="mb-1">Correo</h6>
                  <p class="mb-1 contact-card-line contact-card-soon-email">contacto@…</p>
                  <span class="contact-badge-soon">Pronto</span>
                </div>
              </div>
            </div>
            <div class="col-md-4 col-12">
              <div class="contact-card h-100">
                <div class="contact-icon"><i class="fa fa-language" aria-hidden="true"></i></div>
                <div class="contact-text">
                  <h6 class="mb-1">Idiomas</h6>
                  <p class="mb-0 contact-card-line">Español</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div id="contactCarousel" class="carousel slide contact-modal-carousel d-md-none" data-ride="carousel" data-interval="5000" data-wrap="true" aria-label="Opciones de contacto">
          <ol class="carousel-indicators contact-carousel-indicators">
            <li data-target="#contactCarousel" data-slide-to="0" class="active"></li>
            <li data-target="#contactCarousel" data-slide-to="1"></li>
            <li data-target="#contactCarousel" data-slide-to="2"></li>
          </ol>
          <div class="carousel-inner contact-carousel-inner">
            <div class="carousel-item active">
              <div class="contact-info-cards">
                <a href={whatsappHref} class="contact-card contact-card--link contact-carousel-card" target="_blank" rel="noopener noreferrer">
                  <div class="contact-icon"><i class="fa fa-whatsapp" aria-hidden="true"></i></div>
                  <div class="contact-text">
                    <h6 class="mb-1">WhatsApp</h6>
                    <p class="mb-0 contact-card-line">+56 9 6193 7877</p>
                  </div>
                </a>
              </div>
            </div>
            <div class="carousel-item">
              <div class="contact-info-cards">
                <div class="contact-card contact-card--soon contact-carousel-card">
                  <div class="contact-icon contact-icon--muted"><i class="fa fa-envelope" aria-hidden="true"></i></div>
                  <div class="contact-text">
                    <h6 class="mb-1">Correo</h6>
                    <p class="mb-1 contact-card-line contact-card-soon-email">contacto@…</p>
                    <span class="contact-badge-soon">Pronto</span>
                  </div>
                </div>
              </div>
            </div>
            <div class="carousel-item">
              <div class="contact-info-cards">
                <div class="contact-card contact-carousel-card">
                  <div class="contact-icon"><i class="fa fa-language" aria-hidden="true"></i></div>
                  <div class="contact-text">
                    <h6 class="mb-1">Idiomas</h6>
                    <p class="mb-0 contact-card-line">Español</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <a class="carousel-control-prev contact-carousel-control" href="#contactCarousel" role="button" data-slide="prev" aria-label="Anterior">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          </a>
          <a class="carousel-control-next contact-carousel-control" href="#contactCarousel" role="button" data-slide="next" aria-label="Siguiente">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
          </a>
        </div>

        <div class="contact-form-actions mt-4 justify-content-center mb-0">
          <button type="button" class="btn custom-btn modal-detail-btn" data-dismiss="modal">Cerrar</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    if (!window.jQuery) return;
    window.jQuery('#contactModal').on('shown.bs.modal', function () {
      window.jQuery('#contactCarousel').carousel({ interval: 5000, wrap: true });
    });
  })();
</script>
