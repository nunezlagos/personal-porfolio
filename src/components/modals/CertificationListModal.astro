---
---

<div class="modal fade" id="certificationList" tabindex="-1" role="dialog" aria-labelledby="certificationListLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
  <div class="modal-dialog modal-dialog-centered modal-list-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <div class="modal-header-text">
          <h5 class="modal-title" id="certificationListLabel">Lista de Certificaciones</h5>
          <p class="modal-subtitle">Todas las certificaciones obtenidas. Haz clic en una tarjeta para ver el detalle o en el enlace para ver la credencial.</p>
        </div>
        <button type="button" class="close modal-close" data-dismiss="modal" aria-label="Cerrar">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <div id="certificationListCards" class="modal-list" role="list"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn custom-btn w-100" data-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>
