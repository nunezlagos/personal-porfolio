---
interface Certification {
  id: string;
  name: string;
  date?: string;
  shortDescription?: string;
  description: string;
  img: string;
  repository?: string;
  skill: string[];
}
interface Props {
  certifications: Certification[];
}
const { certifications } = Astro.props;
const truncate = (s: string, max = 150) => (s.length > max ? s.slice(0, max) + '...' : s);
const cardDesc = (c: Certification) => c.shortDescription ?? truncate(c.description, 140);
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.toLowerCase().slice(1);
const displayItems = certifications.slice(0, 3);
---

<section class="certifications section" id="certifications" role="region" aria-label="Certificaciones">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 text-center">
        <h2 class="card-title" data-aos="fade-up" data-anim-id="section-title">CERTIFICACIONES</h2>
        <h6 class="card-subtitle" data-aos="fade-up" data-anim-id="section-subtitle">Últimas certificaciones obtenidas</h6>
      </div>
      <div class="row mt-3" id="certification" role="list" data-anim-container="card-item">
        {displayItems.map((item, index) => (
          <div class="col-lg-4 col-md-6 col-12 pb-5" data-aos="fade-up" data-anim-item="card-item">
            <div
              class="class-thumb"
              data-toggle="modal"
              data-target="#certificationModal"
              data-title={item.name}
              data-description={item.description}
              data-img={item.img}
              data-repository={item.repository ?? ''}
              data-date={item.date ?? ''}
              role="button"
              tabindex={0}
            >
              <img src={item.img} class="img-fluid" alt={item.name} />
              <div class="class-info">
                <h3 class="card-name mb-1">{item.name}</h3>
                <p class="card-description mt-3 card-description-text">{cardDesc(item)}</p>
                <div class="tag-container">
                  <ul class="list-inline mt-3 tag-container">
                    {item.skill.slice(0, 3).map((s) => (
                      <li class="list-inline-item">
                        <span class="tag"><strong>{capitalize(s)}</strong></span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="col-lg-12 text-right mt-5" data-aos="fade-up" data-anim-id="more-btn">
        <a href="#" data-toggle="modal" data-target="#certificationList" class="custom-btn-text mt-3 flex-fill mx-2 smoothScroll" role="button" aria-label="Ver más certificaciones">
          Más certificaciones &nbsp;&nbsp;<i class="fa fa-chevron-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ certifications }}>
  (function () {
    function init() {
      const container = document.getElementById('certification');
      if (!container) return;
      const truncate = (s, max = 150) => (s.length > max ? s.slice(0, max) + '...' : s);
      const cardDesc = (c) => c.shortDescription || truncate(c.description, 140);
      const cap = (s) => s.charAt(0).toUpperCase() + s.toLowerCase().slice(1);
      const esc = (s) => String(s).replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const itemsToShow = () => (window.innerWidth < 768 ? 1 : 3);

      function fillCertificationModal(t, fromList) {
        const modalEl = document.getElementById('certificationModal');
        const footerBtn = document.getElementById('certificationModalFooterBtn');
        if (modalEl) modalEl.setAttribute('data-from-list', fromList ? '1' : '0');
        if (footerBtn) footerBtn.textContent = fromList ? 'Volver' : 'Cerrar';
        const titleEl = document.getElementById('certificationModalLabel');
        const descEl = document.getElementById('certificationModalDescription');
        const imgEl = document.getElementById('certificationModalImage');
        const dateEl = document.getElementById('certificationModalDate');
        const linkEl = document.getElementById('certificationModalLink');
        if (titleEl) titleEl.textContent = t.dataset.title || '';
        if (descEl) descEl.textContent = t.dataset.description || '';
        if (imgEl) { imgEl.src = t.dataset.img || ''; imgEl.alt = t.dataset.title || ''; }
        if (dateEl) dateEl.textContent = t.dataset.date || '';
        if (linkEl) {
          linkEl.href = t.dataset.repository || '#';
          linkEl.style.display = t.dataset.repository ? 'inline-flex' : 'none';
        }
      }

      function renderCards() {
        const n = itemsToShow();
        const limited = certifications.slice(0, n);
        container.innerHTML = limited
          .map(
            (item, i) => `
        <div class="col-lg-4 col-md-6 col-12 pb-5" data-aos="fade-up" data-anim-item="card-item">
          <div class="class-thumb" data-toggle="modal" data-target="#certificationModal" data-title="${item.name.replace(/"/g, '&quot;')}" data-description="${item.description.replace(/"/g, '&quot;')}" data-img="${item.img}" data-repository="${item.repository || ''}" data-date="${item.date || ''}" role="button" tabindex="0">
            <img src="${item.img}" class="img-fluid" alt="${item.name.replace(/"/g, '&quot;')}" />
          <div class="class-info">
            <h3 class="card-name mb-1">${item.name}</h3>
            <p class="card-description mt-3 card-description-text">${truncate(item.description)}</p>
            <div class="tag-container">
              <ul class="list-inline mt-3 tag-container">
                ${item.skill.slice(0, 3).map((s) => `<li class="list-inline-item"><span class="tag"><strong>${cap(s)}</strong></span></li>`).join('')}
              </ul>
            </div>
          </div>
        </div>
      </div>`
          )
          .join('');
        container.querySelectorAll('.class-thumb[data-target="#certificationModal"]').forEach((el) => {
          el.addEventListener('click', function () {
            fillCertificationModal(this);
          });
        });
      }

      function fillList() {
        const container = document.getElementById('certificationListCards');
        if (!container) return;
        const truncate = (s, max = 120) => (s.length > max ? s.slice(0, max) + '...' : s);
        const listDesc = (c) => c.shortDescription || truncate(c.description, 120);
        const cap = (s) => s.charAt(0).toUpperCase() + s.toLowerCase().slice(1);
        const esc = (s) => String(s).replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        container.innerHTML = certifications
          .map(
            (c) => `
        <article class="modal-list-card" role="listitem" data-title="${esc(c.name)}" data-description="${esc(c.description)}" data-img="${c.img}" data-repository="${c.repository || ''}" data-date="${c.date || ''}" tabindex="0">
          <div class="modal-list-card-img">
            <img src="${c.img}" alt="" loading="lazy" />
          </div>
          <div class="modal-list-card-body">
            <h6 class="modal-list-card-title">${c.name.replace(/</g, '&lt;')}</h6>
            <div class="modal-list-card-meta-row">
              <span class="modal-list-card-meta">${c.date ? c.date : 'Sin fecha'}</span>
              <div class="modal-list-card-links">
                ${c.repository ? `<a href="${c.repository}" class="modal-list-card-link" target="_blank" rel="noopener" onclick="event.stopPropagation()">Ver credencial <i class="fa fa-external-link" aria-hidden="true"></i></a>` : ''}
              </div>
            </div>
            <p class="modal-list-card-desc">${esc(listDesc(c))}</p>
            <div class="modal-list-card-tags">
              ${(c.skill || []).slice(0, 4).map((s) => `<span class="modal-list-card-tag">${cap(s)}</span>`).join('')}
            </div>
          </div>
        </article>`
          )
          .join('');
        container.querySelectorAll('.modal-list-card').forEach((el) => {
          el.addEventListener('click', function (e) {
            if (e.target.closest('.modal-list-card-link')) return;
            const t = this;
            container.querySelectorAll('.modal-list-card').forEach((c) => c.classList.remove('modal-list-card--selected'));
            t.classList.add('modal-list-card--selected');
            fillCertificationModal(t, true);
            if (window.jQuery) {
              window.jQuery('#certificationList').modal('hide');
              window.jQuery('#certificationModal').modal('show');
            }
          });
        });
      }
      if (window.jQuery) {
        window.jQuery('#certificationModal').on('hidden.bs.modal', function () {
          if (this.getAttribute('data-from-list') === '1') {
            window.jQuery('#certificationList').modal('show');
            this.setAttribute('data-from-list', '0');
          }
        });
      }

      fillList();
      renderCards();

      if (window.applyGlobalAnimations) window.applyGlobalAnimations();

      window.addEventListener('resize', function () {
        renderCards();
        if (window.applyGlobalAnimations) window.applyGlobalAnimations();
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
