---
interface Project {
  id: string;
  name: string;
  date?: string;
  shortDescription?: string;
  description: string;
  img: string;
  repository?: string;
  url?: string;
  videoUrl?: string;
  skill: string[];
}
interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const truncate = (s: string, max = 150) => (s.length > max ? s.slice(0, max) + '...' : s);
const cardDesc = (p: Project) => p.shortDescription ?? truncate(p.description, 140);
const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.toLowerCase().slice(1);
const displayItems = projects.slice(0, 3);
---

<section class="projects section" id="projects" role="region" aria-label="Projects">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 text-center">
        <h2 class="card-title" data-aos="fade-up" data-anim-id="section-title">PROYECTOS</h2>
        <h6 class="card-subtitle" data-aos="fade-up" data-anim-id="section-subtitle">Últimos trabajos realizados</h6>
      </div>
      <div class="row mt-3" id="proyecto" role="list" data-anim-container="card-item">
        {displayItems.map((item, index) => (
          <div class="col-lg-4 col-md-6 col-12 pb-5" data-aos="fade-up" data-anim-item="card-item">
            <div
              class="class-thumb"
              data-toggle="modal"
              data-target="#projectModal"
              data-title={item.name}
              data-description={item.description}
              data-img={item.img}
              data-date={item.date ?? ''}
              data-repository={item.repository ?? ''}
              data-url={item.url ?? ''}
              data-video={item.videoUrl ?? ''}
              role="button"
              tabindex={0}
            >
              <img src={item.img} class="img-fluid" alt={item.name} />
              <div class="class-info">
                <h3 class="card-name mb-1">{item.name}</h3>
                <p class="card-description mt-3 card-description-text">{cardDesc(item)}</p>
                <div class="tag-container">
                  <ul class="list-inline mt-3 tag-container">
                    {item.skill.slice(0, 3).map((s) => (
                      <li class="list-inline-item">
                        <span class="tag"><strong>{capitalize(s)}</strong></span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="col-lg-12 text-right mt-5" data-aos="fade-up" data-anim-id="more-btn">
        <a href="#" data-toggle="modal" data-target="#projectList" class="custom-btn-text mt-3 flex-fill mx-2 smoothScroll" role="button" aria-label="Ver más proyectos">
          Más proyectos &nbsp;&nbsp;<i class="fa fa-chevron-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ projects }}>
  (function () {
    function init() {
      const container = document.getElementById('proyecto');
      if (!container) return;
      const truncate = (s, max = 150) => (s.length > max ? s.slice(0, max) + '...' : s);
      const cardDesc = (p) => p.shortDescription || truncate(p.description, 140);
      const esc = (s) => String(s).replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      const cap = (s) => s.charAt(0).toUpperCase() + s.toLowerCase().slice(1);
      const itemsToShow = () => (window.innerWidth < 768 ? 1 : 3);
      function fillProjectModal(t, fromList) {
        const modalEl = document.getElementById('projectModal');
        const footerBtn = document.getElementById('projectModalFooterBtn');
        if (modalEl) modalEl.setAttribute('data-from-list', fromList ? '1' : '0');
        if (footerBtn) {
          footerBtn.textContent = fromList ? 'Volver' : 'Cerrar';
        }
        const titleEl = document.getElementById('projectModalLabel');
        const descEl = document.getElementById('projectModalDescription');
        const imgEl = document.getElementById('projectModalImage');
        const dateEl = document.getElementById('projectModalDate');
        const linkRepo = document.getElementById('projectModalLink');
        const linkSite = document.getElementById('projectModalLinkSite');
        const linkVideo = document.getElementById('projectModalLinkVideo');
        if (titleEl) titleEl.textContent = t.dataset.title || '';
        if (descEl) descEl.textContent = t.dataset.description || '';
        if (imgEl) { imgEl.src = t.dataset.img || ''; imgEl.alt = t.dataset.title || ''; }
        if (dateEl) dateEl.textContent = t.dataset.date || '';
        if (linkSite) {
          linkSite.href = t.dataset.url || '#';
          linkSite.style.display = t.dataset.url ? 'inline-flex' : 'none';
        }
        if (linkRepo) {
          linkRepo.href = t.dataset.repository || '#';
          linkRepo.style.display = t.dataset.repository ? 'inline-flex' : 'none';
        }
        if (linkVideo) {
          linkVideo.href = t.dataset.video || '#';
          linkVideo.style.display = t.dataset.video ? 'inline-flex' : 'none';
        }
      }
      function render() {
        const n = itemsToShow();
        const limited = projects.slice(0, n);
        container.innerHTML = limited
          .map(
            (item, i) => `
        <div class="col-lg-4 col-md-6 col-12 pb-5" data-aos="fade-up" data-anim-item="card-item">
          <div class="class-thumb" data-toggle="modal" data-target="#projectModal" data-title="${esc(item.name)}" data-description="${esc(item.description)}" data-img="${item.img}" data-date="${item.date || ''}" data-repository="${item.repository || ''}" data-url="${item.url || ''}" data-video="${esc(item.videoUrl || '')}" role="button" tabindex="0">
            <img src="${item.img}" class="img-fluid" alt="${esc(item.name)}" />
            <div class="class-info">
              <h3 class="card-name mb-1">${item.name}</h3>
              <p class="card-description mt-3 card-description-text">${esc(cardDesc(item))}</p>
              <div class="tag-container">
                <ul class="list-inline mt-3 tag-container">
                  ${item.skill.slice(0, 3).map((s) => `<li class="list-inline-item"><span class="tag"><strong>${cap(s)}</strong></span></li>`).join('')}
                </ul>
              </div>
            </div>
          </div>
        </div>`
          )
          .join('');
        const thumbs = container.querySelectorAll('.class-thumb[data-target="#projectModal"]');
        thumbs.forEach((el) => {
          el.addEventListener('click', function () {
            fillProjectModal(this, false);
          });
        });
      }
      function fillList() {
        const container = document.getElementById('projectListCards');
        if (!container) return;
        const truncate = (s, max = 120) => (s.length > max ? s.slice(0, max) + '...' : s);
        const listDesc = (p) => p.shortDescription || truncate(p.description, 120);
        const cap = (s) => s.charAt(0).toUpperCase() + s.toLowerCase().slice(1);
        const esc = (s) => String(s).replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        container.innerHTML = projects
          .map(
            (p) => `
        <article class="modal-list-card" role="listitem" data-title="${esc(p.name)}" data-description="${esc(p.description)}" data-img="${p.img}" data-date="${p.date || ''}" data-repository="${p.repository || ''}" data-url="${p.url || ''}" data-video="${esc(p.videoUrl || '')}" tabindex="0">
          <div class="modal-list-card-img">
            <img src="${p.img}" alt="" loading="lazy" />
          </div>
          <div class="modal-list-card-body">
            <h6 class="modal-list-card-title">${p.name.replace(/</g, '&lt;')}</h6>
            <div class="modal-list-card-meta-row">
              <span class="modal-list-card-meta">${p.date ? p.date : 'Sin fecha'}</span>
              <div class="modal-list-card-links">
                ${p.repository ? `<a href="${p.repository}" class="modal-list-card-link" target="_blank" rel="noopener" onclick="event.stopPropagation()">Código <i class="fa fa-github" aria-hidden="true"></i></a>` : ''}
                ${p.url ? `<a href="${p.url}" class="modal-list-card-link" target="_blank" rel="noopener" onclick="event.stopPropagation()">Sitio <i class="fa fa-external-link" aria-hidden="true"></i></a>` : ''}
              </div>
            </div>
            <p class="modal-list-card-desc">${esc(listDesc(p))}</p>
            <div class="modal-list-card-tags">
              ${(p.skill || []).slice(0, 4).map((s) => `<span class="modal-list-card-tag">${cap(s)}</span>`).join('')}
            </div>
          </div>
        </article>`
          )
          .join('');
        container.querySelectorAll('.modal-list-card').forEach((el) => {
          el.addEventListener('click', function (e) {
            if (e.target.closest('.modal-list-card-link')) return;
            const t = this;
            container.querySelectorAll('.modal-list-card').forEach((c) => c.classList.remove('modal-list-card--selected'));
            t.classList.add('modal-list-card--selected');
            fillProjectModal(t, true);
            if (window.jQuery) {
              window.jQuery('#projectList').modal('hide');
              window.jQuery('#projectModal').modal('show');
            }
          });
        });
      }
      if (window.jQuery) {
        window.jQuery('#projectModal').on('hidden.bs.modal', function () {
          if (this.getAttribute('data-from-list') === '1') {
            window.jQuery('#projectList').modal('show');
            this.setAttribute('data-from-list', '0');
          }
        });
      }
      fillList();
      render();
      if (window.applyGlobalAnimations) window.applyGlobalAnimations();

      window.addEventListener('resize', () => {
        render();
        if (window.applyGlobalAnimations) window.applyGlobalAnimations();
      });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>
