---
interface ExperienceHighlight {
  title: string;
  description: string;
  dateFrom?: string;
  dateTo?: string;
  date?: string;
}

function highlightDateLabel(h: ExperienceHighlight): string | null {
  if (h.dateFrom && h.dateTo) return `${h.dateFrom} - ${h.dateTo}`;
  if (h.dateFrom) return `Desde ${h.dateFrom}`;
  if (h.dateTo) return `Hasta ${h.dateTo}`;
  if (h.date) return h.date;
  return null;
}
interface Experience {
  id: string;
  dateFrom: string;
  dateTo: string;
  position: string;
  place: string;
  resume: string;
  highlights?: ExperienceHighlight[];
}
interface Props {
  experiences: Experience[];
}
const { experiences } = Astro.props;
const truncate = (s: string, words = 30) => {
  const w = s.split(' ');
  return w.length > words ? w.slice(0, words).join(' ') + '...' : s;
};

type TimelineEntry =
  | { type: 'job'; fullText: string; exp: Experience }
  | { type: 'highlight'; fullText: string; highlight: ExperienceHighlight }
  | { type: 'gap'; dateFrom: string; dateTo: string };
const flattenedEntries: TimelineEntry[] = [];
experiences.forEach((exp, i) => {
  if (i > 0) {
    const prev = experiences[i - 1];
    if (prev.dateTo !== 'Actualidad' && exp.dateFrom !== prev.dateTo) {
      flattenedEntries.push({ type: 'gap', dateFrom: prev.dateTo, dateTo: exp.dateFrom });
    }
  }
  flattenedEntries.push({ type: 'job', fullText: exp.resume, exp });
  (exp.highlights || []).forEach((h) => {
    flattenedEntries.push({ type: 'highlight', fullText: h.description, highlight: h });
  });
});
---

<section class="experience section" id="experiences" role="region" aria-label="Experiences">
  <div class="container">
    <div class="row mt-1">
      <div class="col-lg-12 text-center mb-5">
        <h2 class="card-title" data-aos="fade-up" data-anim-id="section-title">EXPERIENCIA</h2>
        <h6 class="card-subtitle" data-aos="fade-up" data-anim-id="section-subtitle">Trayectoria profesional y logros destacados</h6>
      </div>

      <div class="col-lg-12">
        <div class="timeline" id="experiences-timeline">
          {flattenedEntries.map((entry, idx) => {
            const sideClass = idx % 2 === 0 ? 'left' : 'right';
            if (entry.type === 'gap') {
              return (
                <div class="timeline-item gap" data-aos="fade-up">
                  <div class="timeline-gap-line"></div>
                  <div class="timeline-gap-label">
                    <i class="fa fa-clock-o" aria-hidden="true"></i> {entry.dateFrom} → {entry.dateTo}
                  </div>
                </div>
              );
            }
            if (entry.type === 'job') {
              const exp = entry.exp;
              const short = truncate(exp.resume);
              const isLong = exp.resume.split(' ').length > 30;
              return (
                <div class={`timeline-item job ${sideClass}`} data-aos="fade-up" data-anim-id="timeline-item" data-exp-index={idx}>
                  <div class="timeline-icon">
                    <i class="fa fa-suitcase" aria-hidden="true"></i>
                  </div>
                  <div class="timeline-content">
                    <span class="experience-date">{exp.dateFrom} - {exp.dateTo}</span>
                    <h3 class="experience-title">{exp.position}</h3>
                    <h4 class="experience-place">
                      <i class="fa fa-building-o" aria-hidden="true"></i> {exp.place}
                    </h4>
                    <p class="experience-summary">
                      {isLong ? short : exp.resume}
                      {isLong && <span class="toggle-resume" data-exp-index={idx}>Ver más</span>}
                    </p>
                  </div>
                </div>
              );
            }
            const h = entry.highlight;
            const dateLine = highlightDateLabel(h);
            const shortDesc = truncate(h.description, 20);
            const isLongDesc = h.description.split(' ').length > 20;
            return (
              <div class={`timeline-item highlight ${sideClass}`} data-aos="fade-up" data-anim-id="timeline-item" data-exp-index={idx}>
                <div class="timeline-icon timeline-icon--highlight">
                  <i class="fa fa-star" aria-hidden="true"></i>
                </div>
                <div class="timeline-content timeline-content--highlight">
                  {dateLine && <span class="experience-date experience-date--small">{dateLine}</span>}
                  <h3 class="experience-title experience-title--highlight">{h.title}</h3>
                  <p class="experience-summary">
                    {isLongDesc ? shortDesc : h.description}
                    {isLongDesc && <span class="toggle-resume" data-exp-index={idx}>Ver más</span>}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ flattenedEntries }}>
  (function () {
    const truncate = (s, words) => (s.split(' ').length > words ? s.split(' ').slice(0, words).join(' ') + '...' : s);
    document.getElementById('experiences-timeline')?.addEventListener('click', function (e) {
      const t = e.target;
      if (!t.classList.contains('toggle-resume')) return;
      e.preventDefault();
      const idx = parseInt(t.getAttribute('data-exp-index') || '0', 10);
      const entry = flattenedEntries[idx];
      if (!entry) return;
      const full = entry.fullText;
      const short = truncate(full, entry.type === 'highlight' ? 20 : 30);
      const block = t.closest('.timeline-item');
      const summary = block?.querySelector('.experience-summary');
      if (!summary) return;
      if (summary.textContent?.includes('...')) {
        summary.innerHTML = full + ' <span class="toggle-resume" data-exp-index="' + idx + '">Ver menos</span>';
      } else {
        summary.innerHTML = short + ' <span class="toggle-resume" data-exp-index="' + idx + '">Ver más</span>';
      }
    });
  })();
</script>
