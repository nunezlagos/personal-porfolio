---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminPreviewLayout from '../../layouts/AdminPreviewLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Home from '../../components/Home.astro';
import About from '../../components/About.astro';
import Projects from '../../components/Projects.astro';
import Certifications from '../../components/Certifications.astro';
import Experiences from '../../components/Experiences.astro';
import Modals from '../../components/Modals.astro';
import Footer from '../../components/Footer.astro';
import { verifySession, getSessionCookie, getSessionSecret, getUserRole } from '../../lib/auth';
import { getSection } from '../../lib/content';
import { getEnv } from '../../lib/env';
import { defaultProjects, defaultCertifications, defaultExperiences, defaultHome, defaultAbout, defaultHead } from '../../lib/defaults';

// Lista de imágenes en public/biblioteca (generada con: npm run biblioteca)
import bibliotecaData from '../../data/biblioteca.json';

const env = getEnv(Astro.locals.runtime?.env as Record<string, unknown> | undefined);
const secret = getSessionSecret(env);
const cookie = getSessionCookie(Astro.request.headers);
let isLoggedIn = false;
let email = '';
let role: 'administrador' | 'lector' = 'lector';

if (secret && cookie) {
  const session = await verifySession(cookie, secret);
  if (session) {
    isLoggedIn = true;
    email = session.email;
    role = getUserRole(env, session.email);
  }
}

let allData = {
  projects: defaultProjects,
  certifications: defaultCertifications,
  experiences: defaultExperiences,
  home: defaultHome,
  about: defaultAbout,
  head: defaultHead,
};

if (isLoggedIn) {
  try {
    const [projects, certifications, experiences, home, about, head] = await Promise.all([
      getSection('projects'),
      getSection('certifications'),
      getSection('experiences'),
      getSection('home'),
      getSection('about'),
      getSection('head'),
    ]);
    if (Array.isArray(projects)) allData.projects = projects as typeof defaultProjects;
    if (Array.isArray(certifications)) allData.certifications = certifications as typeof defaultCertifications;
    if (Array.isArray(experiences)) allData.experiences = experiences as typeof defaultExperiences;
    if (home && typeof home === 'object') allData.home = home as typeof defaultHome;
    if (about && typeof about === 'object') allData.about = about as typeof defaultAbout;
    if (head && typeof head === 'object') allData.head = head as typeof defaultHead;
  } catch (e) {
    console.error('Error fetching data', e);
  }
}

const initialDataStr = JSON.stringify(allData);
const bibliotecaProyectos = Array.isArray(bibliotecaData.proyectos) ? bibliotecaData.proyectos : [];
const bibliotecaCertificados = Array.isArray(bibliotecaData.certificados) ? bibliotecaData.certificados : [];
const bibliotecaCv = Array.isArray(bibliotecaData.cv) ? bibliotecaData.cv : [];

const error = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  auth_config: 'Faltan variables de configuración. Revisa .dev.vars',
  token: 'Error al obtener el token de Google. Comprueba la URI de redirección en la consola de Google.',
  userinfo: 'No se pudo obtener el perfil de Google',
  email: 'Tu cuenta de Google no tiene email',
  forbidden: 'Tu correo no está autorizado. Añade tu email en ALLOWED_ADMIN_EMAILS en .dev.vars',
};
const errorMsg = error ? (errorMessages[error] || 'Error de autenticación') : null;

const tabs = [
  { key: 'head', label: 'SEO / Meta', icon: '◇' },
  { key: 'home', label: 'Home', icon: '⌂' },
  { key: 'about', label: 'Sobre mí', icon: '👤' },
  { key: 'projects', label: 'Proyectos', icon: '⌨' },
  { key: 'certifications', label: 'Certificaciones', icon: '✓' },
  { key: 'experiences', label: 'Experiencia', icon: '💼' },
];

const meta = allData.head;
const homeData = allData.home;
const aboutData = allData.about;
---

{!isLoggedIn ? (
  <AdminLayout title="Mantenedor" isLoggedIn={isLoggedIn} email={email}>
    <div class="admin-login">
      <div class="admin-login-card">
        <h1 class="admin-login-title">Panel de administración</h1>
        {errorMsg && <p class="admin-login-error">{errorMsg}</p>}
        <p class="admin-login-desc">Inicia sesión con tu cuenta de Google (correo autorizado) para editar el contenido del portafolio.</p>
        <a href="/api/auth/login" class="admin-btn admin-btn-primary">Iniciar sesión con Google</a>
      </div>
    </div>
  </AdminLayout>
) : (
  <AdminPreviewLayout
    title={meta.title}
    description={meta.description}
    keywords={meta.keywords}
    author={meta.author}
    ogImage={meta.openGraph?.image ?? '/images/icon/android-chrome-512x512.png'}
    ogUrl={meta.openGraph?.url ?? ''}
    isLoggedIn={true}
    email={email}
    role={role}
  >
    {/* Contenido igual que la página principal; los botones de editar están arriba en la barra */}
    <Navbar />
    <div class="admin-section-wrap">
      <Home
        subtitle={homeData.subtitle}
        title={homeData.title}
        aboutUrl={homeData.aboutUrl}
        aboutText={homeData.aboutText}
        socialLinks={homeData.socialLinks}
      />
    </div>

    <div class="admin-section-wrap">
      <About
        name={aboutData.name}
        title={aboutData.title}
        description={aboutData.description}
        cvUrl={aboutData.cvUrl}
        cvText={aboutData.cvText}
        projectsUrl={aboutData.projectsUrl}
        projectsText={aboutData.projectsText}
        certificationsUrl={aboutData.certificationsUrl}
        certificationsText={aboutData.certificationsText}
        experiencesUrl={aboutData.experiencesUrl}
        experiencesText={aboutData.experiencesText}
      />
    </div>

    <div class="admin-section-wrap">
      <Projects projects={allData.projects} />
    </div>

    <div class="admin-section-wrap">
      <Certifications certifications={allData.certifications} />
    </div>

    <div class="admin-section-wrap">
      <Experiences experiences={allData.experiences} />
    </div>

    <Modals />
    <Footer />

    <!-- Loading en página (antes de abrir el modal): scroll → loading → modal -->
    <div id="admin-page-loading" class="admin-page-loading" aria-live="polite" hidden>
      <span class="admin-page-loading-spinner" aria-hidden="true"></span>
      <span>Cargando configuración…</span>
    </div>

    <!-- Contenedor oculto con todos los panes de edición (se mueven al modal al abrir) -->
    <div id="admin-panes-container" class="admin-panes-container" aria-hidden="true" hidden>
      <div id="pane-head-home" class="admin-form-panel admin-form-panel--combined" data-section="head" hidden>
        <h4 class="card-title">SEO / Meta</h4>
        <p class="card-title-desc">Título, descripción y keywords del sitio.</p>
        <form id="form-head" class="admin-form">
          <div id="form-fields-head" class="admin-form-grid"></div>
        </form>
        <hr class="admin-form-panel-divider" aria-hidden="true">
        <h4 class="card-title">Home</h4>
        <form id="form-home" class="admin-form">
          <div id="form-fields-home" class="admin-form-grid"></div>
        </form>
        <div class="admin-form-actions">
          <button type="button" id="btn-save-head-home" class="admin-btn admin-btn-primary">Guardar cambios</button>
        </div>
      </div>
      <div id="pane-about" class="admin-form-panel" data-section="about" hidden>
        <h4 class="card-title">Sobre mí</h4>
        <form id="form-about" class="admin-form">
          <div id="form-fields-about" class="admin-form-grid"></div>
          <div class="admin-form-actions">
            <button type="submit" class="admin-btn admin-btn-primary">Guardar cambios</button>
          </div>
        </form>
      </div>
      <div id="pane-projects" class="admin-form-panel" data-section="projects" hidden>
        <h4 class="card-title">Proyectos</h4>
        <div class="admin-list-toolbar">
          <button type="button" class="admin-btn admin-btn-primary" id="btn-add-projects"><i class="fa fa-plus" aria-hidden="true"></i> Agregar proyecto</button>
        </div>
        <div id="item-form-wrap-projects" class="admin-item-form-wrap" hidden>
          <h5 class="card-title card-title--sm" id="item-form-title-projects">Nuevo proyecto</h5>
          <form id="form-item-projects" class="admin-form">
            <div id="form-item-fields-projects" class="admin-form-grid"></div>
            <div class="admin-form-actions">
              <button type="submit" class="admin-btn admin-btn-primary">Guardar</button>
              <button type="button" class="admin-btn admin-btn-ghost" data-cancel-item="projects">Cancelar</button>
            </div>
          </form>
        </div>
        <div id="view-container-projects" class="admin-table-wrap"></div>
      </div>
      <div id="pane-certifications" class="admin-form-panel" data-section="certifications" hidden>
        <h4 class="card-title">Certificaciones</h4>
        <div class="admin-list-toolbar">
          <button type="button" class="admin-btn admin-btn-primary" id="btn-add-certifications"><i class="fa fa-plus" aria-hidden="true"></i> Agregar certificación</button>
        </div>
        <div id="item-form-wrap-certifications" class="admin-item-form-wrap" hidden>
          <h5 class="card-title card-title--sm" id="item-form-title-certifications">Nueva certificación</h5>
          <form id="form-item-certifications" class="admin-form">
            <div id="form-item-fields-certifications" class="admin-form-grid"></div>
            <div class="admin-form-actions">
              <button type="submit" class="admin-btn admin-btn-primary">Guardar</button>
              <button type="button" class="admin-btn admin-btn-ghost" data-cancel-item="certifications">Cancelar</button>
            </div>
          </form>
        </div>
        <div id="view-container-certifications" class="admin-table-wrap"></div>
      </div>
      <div id="pane-experiences" class="admin-form-panel" data-section="experiences" hidden>
        <h4 class="card-title">Experiencia</h4>
        <div class="admin-list-toolbar">
          <button type="button" class="admin-btn admin-btn-primary" id="btn-add-experiences"><i class="fa fa-plus" aria-hidden="true"></i> Agregar experiencia</button>
        </div>
        <div id="item-form-wrap-experiences" class="admin-item-form-wrap" hidden>
          <h5 class="card-title card-title--sm" id="item-form-title-experiences">Nueva experiencia</h5>
          <form id="form-item-experiences" class="admin-form">
            <div id="form-item-fields-experiences" class="admin-form-grid"></div>
            <div class="admin-form-actions">
              <button type="submit" class="admin-btn admin-btn-primary">Guardar</button>
              <button type="button" class="admin-btn admin-btn-ghost" data-cancel-item="experiences">Cancelar</button>
            </div>
          </form>
        </div>
        <div id="view-container-experiences" class="admin-table-wrap"></div>
      </div>
    </div>

    <!-- Modal único de edición -->
    <div id="admin-edit-modal" class="admin-edit-modal" role="dialog" aria-modal="true" aria-labelledby="admin-edit-modal-title" hidden>
      <div class="admin-edit-modal-backdrop" data-close-admin-modal></div>
      <div class="admin-edit-modal-content">
        <div class="admin-edit-modal-header">
          <h2 id="admin-edit-modal-title" class="admin-edit-modal-title">Editar</h2>
          <button type="button" class="admin-edit-modal-close" data-close-admin-modal aria-label="Cerrar">&times;</button>
        </div>
        <div id="admin-edit-modal-body" class="admin-edit-modal-body"></div>
      </div>
    </div>

    <div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
    <div id="gallery-modal" class="modal gallery-modal" role="dialog" aria-modal="true" aria-label="Elegir imagen" hidden>
      <div class="modal-backdrop" data-close-gallery></div>
      <div class="modal-content gallery-modal-content">
        <h2 class="modal-title">Elegir imagen</h2>
        <div id="gallery-modal-grid" class="image-picker-grid"></div>
        <button type="button" class="admin-btn admin-btn-ghost gallery-modal-close" data-close-gallery>Cerrar</button>
      </div>
    </div>
  </AdminPreviewLayout>
)}

<script define:vars={{ initialDataStr, bibliotecaProyectos, bibliotecaCertificados, bibliotecaCv }}>
  (function() {
    function init() {
  let allData = JSON.parse(initialDataStr);
  let currentTab = 'head';
  let editingItemIndex = null;

  const schemas = {
    projects: [
      { key: 'id', label: 'ID', type: 'text' },
      { key: 'name', label: 'Nombre', type: 'text' },
      { key: 'date', label: 'Fecha', type: 'date' },
      { key: 'description', label: 'Descripción', type: 'textarea' },
      { key: 'img', label: 'Imagen', type: 'image-picker' },
      { key: 'repository', label: 'Repositorio', type: 'url' },
      { key: 'url', label: 'Sitio Web', type: 'url' },
      { key: 'skill', label: 'Skills (separados por coma)', type: 'array-string' }
    ],
    certifications: [
      { key: 'id', label: 'ID', type: 'text' },
      { key: 'name', label: 'Nombre', type: 'text' },
      { key: 'date', label: 'Fecha', type: 'date' },
      { key: 'description', label: 'Descripción', type: 'textarea' },
      { key: 'img', label: 'Imagen', type: 'image-picker' },
      { key: 'repository', label: 'URL Credencial', type: 'url' },
      { key: 'skill', label: 'Skills', type: 'array-string' }
    ],
    experiences: [
      { key: 'id', label: 'ID', type: 'text' },
      { key: 'position', label: 'Cargo', type: 'text' },
      { key: 'place', label: 'Empresa', type: 'text' },
      { key: 'dateFrom', label: 'Desde', type: 'date' },
      { key: 'dateTo', label: 'Hasta', type: 'date' },
      { key: 'resume', label: 'Resumen', type: 'textarea' }
    ],
    home: [
      { key: 'subtitle', label: 'Subtítulo', type: 'text' },
      { key: 'title', label: 'Título Principal', type: 'text' }
    ],
    about: [
      { key: 'name', label: 'Nombre', type: 'text' },
      { key: 'title', label: 'Título', type: 'text' },
      { key: 'description', label: 'Descripción', type: 'textarea' },
      { key: 'cvText', label: 'Texto CV', type: 'text' },
      { key: 'cvUrl', label: 'Archivo CV (PDF)', type: 'pdf-picker' },
      { key: 'projectsText', label: 'Texto Proyectos', type: 'text' },
      { key: 'certificationsText', label: 'Texto Certificaciones', type: 'text' },
      { key: 'experiencesText', label: 'Texto Experiencia', type: 'text' }
    ],
    head: [
      { key: 'title', label: 'Título (Meta)', type: 'text' },
      { key: 'description', label: 'Descripción (Meta)', type: 'textarea' },
      { key: 'keywords', label: 'Keywords', type: 'textarea' },
      { key: 'author', label: 'Autor', type: 'text' }
    ]
  };

  const listKeys = ['projects', 'certifications', 'experiences'];
  const objectKeys = ['head', 'home', 'about'];

  function openGalleryModal(urls, inputEl, previewEl, opts) {
    const isPdf = opts?.type === 'pdf';
    const modal = document.getElementById('gallery-modal');
    const grid = document.getElementById('gallery-modal-grid');
    const titleEl = document.querySelector('.gallery-modal-content .modal-title');
    const editModal = document.getElementById('admin-edit-modal');
    if (!modal || !grid) return;
    if (titleEl) titleEl.textContent = isPdf ? 'Elegir archivo PDF' : 'Elegir imagen';
    grid.innerHTML = '';
    grid.className = 'image-picker-grid' + (isPdf ? ' image-picker-grid--pdf' : '');
    urls.forEach((url) => {
      const name = url.split('/').pop() || url;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'image-picker-item' + (isPdf ? ' image-picker-item--pdf' : '');
      btn.title = url;
      if (isPdf) {
        btn.innerHTML = '<i class="fa fa-file-pdf-o" aria-hidden="true"></i><span>' + decodeURIComponent(name) + '</span>';
      } else {
        btn.innerHTML = '<img src="' + url + '" alt=""><span>' + name + '</span>';
      }
      btn.onclick = () => {
        inputEl.value = url;
        if (previewEl) {
          previewEl.innerHTML = '';
          if (isPdf) {
            const span = document.createElement('span');
            span.className = 'pdf-picker-preview-name';
            span.textContent = decodeURIComponent(name);
            previewEl.appendChild(span);
          } else {
            const img = document.createElement('img');
            img.src = url;
            img.alt = '';
            previewEl.appendChild(img);
          }
        }
        closeGalleryModal();
      };
      grid.appendChild(btn);
    });
    if (editModal) editModal.classList.add('admin-edit-modal--gallery-open');
    document.body.appendChild(modal);
    modal.hidden = false;
  }

  function closeGalleryModal() {
    const modal = document.getElementById('gallery-modal');
    const editModal = document.getElementById('admin-edit-modal');
    if (modal) modal.hidden = true;
    if (editModal) editModal.classList.remove('admin-edit-modal--gallery-open');
  }

  document.querySelectorAll('[data-close-gallery]').forEach(function(el) {
    el.addEventListener('click', function() {
      if (typeof closeGalleryModal === 'function') closeGalleryModal();
      else document.getElementById('gallery-modal').hidden = true;
    });
  });

  function showToast(message, type = 'success') {
    const el = document.getElementById('toast');
    el.textContent = message;
    el.hidden = false;
    el.className = 'toast toast--' + type;
    clearTimeout(el._toastTimer);
    el._toastTimer = setTimeout(() => { el.hidden = true; }, 3000);
  }

  function createField(container, fieldSchema, value, opts = {}) {
    const type = fieldSchema.type || 'text';
    const isFull = type === 'textarea' || type === 'image-picker' || type === 'pdf-picker';
    const div = document.createElement('div');
    div.className = 'form-group admin-form-col' + (isFull ? ' form-group--full' : '');
    const label = document.createElement('label');
    label.textContent = fieldSchema.label || fieldSchema.key;
    div.appendChild(label);

    if (type === 'image-picker') {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = fieldSchema.key;
      input.value = value || '';
      input.dataset.type = 'text';
      div.appendChild(input);

      const row = document.createElement('div');
      row.className = 'image-picker-row';
      const preview = document.createElement('div');
      preview.className = 'image-picker-preview';
      if (value) {
        const img = document.createElement('img');
        img.src = value;
        img.alt = '';
        preview.appendChild(img);
      } else {
        const empty = document.createElement('span');
        empty.className = 'image-picker-empty';
        empty.textContent = 'Ninguna';
        preview.appendChild(empty);
      }
      row.appendChild(preview);
      const btnOpen = document.createElement('button');
      btnOpen.type = 'button';
      btnOpen.className = 'admin-btn';
      btnOpen.innerHTML = '<i class="fa fa-picture-o" aria-hidden="true"></i> Abrir galería';
      const urls = opts.bibliotecaUrls || [];
      btnOpen.onclick = () => openGalleryModal(urls, input, preview, {});
      row.appendChild(btnOpen);
      div.appendChild(row);

      if (!urls.length) {
        const hint = document.createElement('p');
        hint.className = 'image-picker-hint';
        hint.textContent = 'Añade imágenes en public/biblioteca/proyectos o certificados y ejecuta: npm run biblioteca';
        div.appendChild(hint);
      }
    } else if (type === 'pdf-picker') {
      const input = document.createElement('input');
      input.type = 'hidden';
      input.name = fieldSchema.key;
      input.value = value || '';
      input.dataset.type = 'text';
      div.appendChild(input);

      const row = document.createElement('div');
      row.className = 'image-picker-row pdf-picker-row';
      const preview = document.createElement('div');
      preview.className = 'image-picker-preview pdf-picker-preview';
      if (value) {
        const name = (value.split('/').pop() || value);
        const span = document.createElement('span');
        span.className = 'pdf-picker-preview-name';
        span.textContent = decodeURIComponent(name);
        preview.appendChild(span);
      } else {
        const empty = document.createElement('span');
        empty.className = 'image-picker-empty';
        empty.textContent = 'Ninguno';
        preview.appendChild(empty);
      }
      row.appendChild(preview);
      const btnOpen = document.createElement('button');
      btnOpen.type = 'button';
      btnOpen.className = 'admin-btn';
      btnOpen.innerHTML = '<i class="fa fa-file-pdf-o" aria-hidden="true"></i> Abrir galería';
      const urls = opts.bibliotecaPdfUrls || [];
      btnOpen.onclick = () => openGalleryModal(urls, input, preview, { type: 'pdf' });
      row.appendChild(btnOpen);
      div.appendChild(row);

      if (!urls.length) {
        const hint = document.createElement('p');
        hint.className = 'image-picker-hint';
        hint.textContent = 'Añade PDFs en public/biblioteca/cv y ejecuta: npm run biblioteca';
        div.appendChild(hint);
      }
    } else if (type === 'textarea') {
      const input = document.createElement('textarea');
      input.rows = 4;
      input.value = value || '';
      input.name = fieldSchema.key;
      input.dataset.type = type;
      div.appendChild(input);
    } else if (type === 'date') {
      const input = document.createElement('input');
      input.type = 'date';
      let dateVal = value || '';
      if (dateVal && typeof dateVal === 'string' && dateVal !== 'Actualidad') {
        const d = dateVal.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
        if (d) dateVal = d[3] + '-' + d[2].padStart(2, '0') + '-' + d[1].padStart(2, '0');
        else if (!/^\d{4}-\d{2}-\d{2}$/.test(dateVal)) dateVal = '';
      } else dateVal = '';
      input.value = dateVal;
      input.name = fieldSchema.key;
      input.dataset.type = type;
      div.appendChild(input);
    } else {
      const input = document.createElement('input');
      input.type = type === 'url' ? 'url' : 'text';
      input.value = Array.isArray(value) ? value.join(', ') : (value || '');
      input.name = fieldSchema.key;
      input.dataset.type = type;
      div.appendChild(input);
    }
    container.appendChild(div);
  }

  function switchTab(key) {
    currentTab = key;
    document.querySelectorAll('.admin-tab').forEach(btn => {
      btn.setAttribute('aria-selected', btn.getAttribute('data-tab') === key ? 'true' : 'false');
    });
    document.querySelectorAll('.admin-pane').forEach(pane => {
      pane.hidden = pane.id !== 'pane-' + key;
    });
    if (objectKeys.includes(key)) {
      const fieldsContainer = document.getElementById('form-fields-' + key);
      if (fieldsContainer && fieldsContainer.children.length === 0) {
        const data = allData[key];
        const fields = schemas[key] || Object.keys(data).map(k => ({ key: k }));
        fieldsContainer.innerHTML = '';
        fields.forEach(f => createField(fieldsContainer, f, data[f.key], { bibliotecaUrls: key === 'home' ? [] : key === 'about' ? [] : key === 'head' ? [] : [] }));
      }
    }
    if (listKeys.includes(key)) {
      renderTable(key, allData[key]);
      listKeys.forEach(k => {
        const wrap = document.getElementById('item-form-wrap-' + k);
        if (wrap) wrap.hidden = true;
      });
      editingItemIndex = null;
    }
  }

  function renderTable(key, data) {
    const container = document.getElementById('view-container-' + key);
    if (!container) return;
    container.innerHTML = '';
    if (!data || data.length === 0) {
      container.innerHTML = '<p class="view-empty">No hay elementos. Haz clic en "Agregar" para crear uno.</p>';
      return;
    }
    const displayFields = schemas[key].slice(0, 4);
    const table = document.createElement('table');
    table.className = 'admin-table';
    const thead = document.createElement('thead');
    const headerRow = document.createElement('tr');
    displayFields.forEach(f => {
      const th = document.createElement('th');
      th.textContent = f.label;
      headerRow.appendChild(th);
    });
    const thAction = document.createElement('th');
    thAction.textContent = 'Acciones';
    headerRow.appendChild(thAction);
    thead.appendChild(headerRow);
    table.appendChild(thead);
    const tbody = document.createElement('tbody');
    data.forEach((item, index) => {
      const tr = document.createElement('tr');
      displayFields.forEach(f => {
        const td = document.createElement('td');
        let val = item[f.key];
        if (Array.isArray(val)) val = val.join(', ');
        if (f.key === 'img' && val) td.innerHTML = '<img src="' + val + '" alt="" class="table-thumb">';
        else {
          if (typeof val === 'string' && val.length > 40) val = val.substring(0, 40) + '…';
          td.textContent = val || '';
        }
        tr.appendChild(td);
      });
      const tdAction = document.createElement('td');
      tdAction.className = 'actions-cell';
      const btnEdit = document.createElement('button');
      btnEdit.type = 'button';
      btnEdit.className = 'admin-btn admin-btn-icon';
      btnEdit.innerHTML = '<i class="fa fa-pencil" aria-hidden="true"></i>';
      btnEdit.title = 'Editar';
      btnEdit.onclick = () => showItemForm(key, index);
      const btnDelete = document.createElement('button');
      btnDelete.type = 'button';
      btnDelete.className = 'admin-btn admin-btn-danger admin-btn-icon';
      btnDelete.innerHTML = '<i class="fa fa-trash" aria-hidden="true"></i>';
      btnDelete.title = 'Eliminar';
      btnDelete.onclick = () => deleteItem(key, index);
      tdAction.append(btnEdit, btnDelete);
      tr.appendChild(tdAction);
      tbody.appendChild(tr);
    });
    table.appendChild(tbody);
    container.appendChild(table);
  }

  function showItemForm(key, index) {
    editingItemIndex = index;
    const wrap = document.getElementById('item-form-wrap-' + key);
    const titleEl = document.getElementById('item-form-title-' + key);
    const fieldsContainer = document.getElementById('form-item-fields-' + key);
    const dataList = allData[key];
    const item = index >= 0 ? dataList[index] : {};
    if (titleEl) titleEl.textContent = index >= 0 ? 'Editar ítem' : 'Nuevo ítem';
    fieldsContainer.innerHTML = '';
    const bibliotecaUrls = key === 'projects' ? bibliotecaProyectos : key === 'certifications' ? bibliotecaCertificados : [];
    schemas[key].forEach(f => createField(fieldsContainer, f, item[f.key], { bibliotecaUrls }));
    if (wrap) wrap.hidden = false;
  }

  function hideItemForm(key) {
    const wrap = document.getElementById('item-form-wrap-' + key);
    if (wrap) wrap.hidden = true;
    editingItemIndex = null;
  }

  async function saveData(key, newData, opts) {
    const form = document.getElementById('form-' + key) || document.getElementById('form-item-' + key);
    const submitBtn = form?.querySelector('[type="submit"]') || (key === 'head' || key === 'home' ? document.getElementById('btn-save-head-home') : null);
    const origText = submitBtn?.textContent;
    if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Guardando…'; }
    try {
      const res = await fetch('/api/sections/' + key, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(newData),
      });
      if (res.ok) {
        allData[key] = newData;
        showToast('Cambios guardados correctamente');
        if (listKeys.includes(key)) {
          renderTable(key, newData);
          hideItemForm(key);
        }
        if (!opts?.noClose && typeof closeEditModal === 'function' && document.getElementById('admin-edit-modal') && !document.getElementById('admin-edit-modal').hidden) {
          closeEditModal();
        }
      } else {
        let msg = 'Error al guardar';
        try {
          const err = await res.json();
          if (err && typeof err.error === 'string') msg = err.error;
        } catch (_) {}
        showToast(msg, 'error');
      }
    } catch {
      showToast('Error de conexión', 'error');
    } finally {
      if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = origText || 'Guardar'; }
    }
  }

  document.querySelectorAll('.admin-tab').forEach(btn => {
    btn.addEventListener('click', () => switchTab(btn.getAttribute('data-tab')));
  });

  const isPreviewMode = document.querySelector('.admin-edit-pill') !== null;
  const sectionLabels = { head: 'SEO / Home', home: 'SEO / Home', about: 'Sobre mí', projects: 'Proyectos', certifications: 'Certificaciones', experiences: 'Experiencia' };
  const originalPaneParent = {};

  function ensurePaneContent(key) {
    if (objectKeys.includes(key)) {
      const fieldsContainer = document.getElementById('form-fields-' + key);
      if (fieldsContainer && fieldsContainer.children.length === 0) {
        const data = allData[key];
        const fields = schemas[key] || [];
        fieldsContainer.innerHTML = '';
        const urls = key === 'projects' ? bibliotecaProyectos : key === 'certifications' ? bibliotecaCertificados : [];
        const pdfUrls = key === 'about' ? bibliotecaCv : [];
        fields.forEach(f => createField(fieldsContainer, f, data[f.key], { bibliotecaUrls: urls, bibliotecaPdfUrls: pdfUrls }));
      }
    }
    if (listKeys.includes(key)) {
      renderTable(key, allData[key]);
      const wrap = document.getElementById('item-form-wrap-' + key);
      if (wrap) wrap.hidden = true;
      editingItemIndex = null;
    }
  }

  function openEditModal(key) {
    const paneId = (key === 'head' || key === 'home') ? 'pane-head-home' : ('pane-' + key);
    const pane = document.getElementById(paneId);
    const modal = document.getElementById('admin-edit-modal');
    const modalBody = document.getElementById('admin-edit-modal-body');
    const modalTitle = document.getElementById('admin-edit-modal-title');
    const pageLoading = document.getElementById('admin-page-loading');
    const container = document.getElementById('admin-panes-container');
    if (!pane || !modal || !modalBody) return;

    closeEditModal();
    if (!originalPaneParent[key]) originalPaneParent[key] = container || pane.parentNode;
    if (key === 'head' || key === 'home') originalPaneParent.head = originalPaneParent.home = container || pane.parentNode;

    if (modalTitle) modalTitle.textContent = 'Editar: ' + (sectionLabels[key] || key);
    document.querySelectorAll('.admin-edit-pill').forEach(function(p) { p.classList.remove('admin-edit-pill--active'); });
    var activePill = document.querySelector('.admin-edit-pill[data-section="' + key + '"]');
    if (activePill) activePill.classList.add('admin-edit-pill--active');

    var sectionEl = key !== 'head' ? document.getElementById(key) : null;

    function openModalWithContent() {
      ensurePaneContent(key);
      if (key === 'head' || key === 'home') ensurePaneContent(key === 'head' ? 'home' : 'head');
      if (pane.parentNode !== modalBody) {
        pane.parentNode.removeChild(pane);
        modalBody.appendChild(pane);
      }
      pane.hidden = false;
      if (pageLoading) pageLoading.hidden = true;
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
    }

    if (sectionEl) {
      sectionEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(function() {
        if (pageLoading) pageLoading.hidden = false;
        setTimeout(openModalWithContent, 500);
      }, 400);
    } else {
      if (pageLoading) pageLoading.hidden = false;
      setTimeout(openModalWithContent, 500);
    }
  }

  function closeEditModal() {
    const modal = document.getElementById('admin-edit-modal');
    const modalBody = document.getElementById('admin-edit-modal-body');
    const container = document.getElementById('admin-panes-container');
    const pageLoading = document.getElementById('admin-page-loading');
    if (!modal || !modalBody) return;
    const pane = modalBody.querySelector('.admin-form-panel');
    if (pane && pane.dataset.section) {
      const parent = originalPaneParent[pane.dataset.section] || container;
      if (parent) {
        pane.hidden = true;
        modalBody.removeChild(pane);
        parent.appendChild(pane);
      }
    }
    if (pageLoading) pageLoading.hidden = true;
    modal.hidden = true;
    document.body.style.overflow = '';
    document.querySelectorAll('.admin-edit-pill').forEach(function(p) { p.classList.remove('admin-edit-pill--active'); });
  }

  if (isPreviewMode) {
    document.querySelectorAll('.admin-edit-pill').forEach(btn => {
      const key = btn.getAttribute('data-section');
      if (key) btn.addEventListener('click', () => openEditModal(key));
    });
    document.querySelectorAll('[data-close-admin-modal]').forEach(el => {
      el.addEventListener('click', closeEditModal);
    });
    const adminModal = document.getElementById('admin-edit-modal');
    if (adminModal) adminModal.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeEditModal(); });
  } else {
    document.querySelectorAll('.admin-tab').forEach(btn => {
      btn.addEventListener('click', () => switchTab(btn.getAttribute('data-tab')));
    });
    switchTab('head');
  }

  ['about'].forEach(key => {
    const form = document.getElementById('form-' + key);
    if (!form) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const newData = { ...allData[key] };
      form.querySelectorAll('input, textarea').forEach(input => {
        newData[input.name] = input.value;
      });
      saveData(key, newData);
    });
  });

  const btnSaveHeadHome = document.getElementById('btn-save-head-home');
  if (btnSaveHeadHome) {
    btnSaveHeadHome.addEventListener('click', async () => {
      const formHead = document.getElementById('form-head');
      const formHome = document.getElementById('form-home');
      if (!formHead || !formHome) return;
      const headData = { ...allData.head };
      formHead.querySelectorAll('input, textarea').forEach(input => { headData[input.name] = input.value; });
      const homeData = { ...allData.home };
      formHome.querySelectorAll('input, textarea').forEach(input => { homeData[input.name] = input.value; });
      await saveData('head', headData, { noClose: true });
      await saveData('home', homeData);
    });
  }

  ['form-head', 'form-home'].forEach(id => {
    const form = document.getElementById(id);
    if (form) form.addEventListener('submit', (e) => { e.preventDefault(); });
  });

  listKeys.forEach(key => {
    const addBtn = document.getElementById('btn-add-' + key);
    if (addBtn) addBtn.addEventListener('click', () => showItemForm(key, -1));
    const form = document.getElementById('form-item-' + key);
    if (!form) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fieldsContainer = document.getElementById('form-item-fields-' + key);
      const dataList = allData[key];
      const item = editingItemIndex >= 0 ? dataList[editingItemIndex] : {};
      const newItem = { ...item };
      fieldsContainer.querySelectorAll('input, textarea').forEach(input => {
        const k = input.name;
        const type = input.dataset.type;
        let val = input.value;
        if (type === 'array-string') val = val.split(',').map(s => s.trim()).filter(Boolean);
        if (key === 'experiences' && k === 'dateTo' && val === '' && item.dateTo === 'Actualidad') val = 'Actualidad';
        newItem[k] = val;
      });
      const newDataList = [...dataList];
      if (editingItemIndex >= 0) newDataList[editingItemIndex] = newItem;
      else {
        if (!newItem.id) newItem.id = String(Date.now());
        newDataList.push(newItem);
      }
      saveData(key, newDataList);
    });
  });

  document.querySelectorAll('[data-cancel-item]').forEach(btn => {
    btn.addEventListener('click', () => hideItemForm(btn.getAttribute('data-cancel-item')));
  });

  window.deleteItem = (key, index) => {
    if (!confirm('¿Eliminar este elemento?')) return;
    const newDataList = allData[key].filter((_, i) => i !== index);
    saveData(key, newDataList);
  };

  if (!isPreviewMode) switchTab('head');
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
